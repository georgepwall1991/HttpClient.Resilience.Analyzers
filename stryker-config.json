{
  "stryker-config": {
    "project": "src/HttpClient.Resilience.Analyzers/HttpClient.Resilience.Analyzers.csproj",
    "test-projects": [
      "tests/HttpClient.Resilience.Analyzers.Tests/HttpClient.Resilience.Analyzers.Tests.csproj"
    ],
    "mutate": [
      "**/HCR006_InvalidHttpClientTimeoutAnalyzer.cs",
      "**/HCR041_UnsafeMethodRetryAnalyzer.cs",
      "**/HCR042_UnsafeMethodHedgingAnalyzer.cs",
      "**/HCR043_CustomPipelineUnsafeRetryAnalyzer.cs",
      "**/HCR065_RequestMessageResendAnalyzer.cs",
      "**/HCR087_BaseAddressMissingTrailingSlashAnalyzer.cs",
      "**/HCR088_TypedClientMissingHttpClientConstructorAnalyzer.cs",
      "**/BlockSyntaxIndex.cs",
      "**/SyntaxTransparency.cs",
      "**/FrameworkRegistrationMethods.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 80,
      "break": 80
    },
    "concurrency": 2,
    "reporters": [
      "html",
      "json",
      "cleartext"
    ],
    "ignore-methods": [
      "ConfigureGeneratedCodeAnalysis",
      "EnableConcurrentExecution"
    ]
  }
}
