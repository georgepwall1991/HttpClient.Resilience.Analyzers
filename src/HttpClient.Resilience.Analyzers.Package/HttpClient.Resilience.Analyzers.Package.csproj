<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>HttpClient.Resilience.Analyzers</PackageId>
    <Version>0.1.151</Version>
    <Title>HttpClient Resilience Analyzers — IHttpClientFactory, Polly, and Http.Resilience</Title>
    <Authors>George Wall</Authors>
    <Copyright>Copyright (c) George Wall and contributors 2026</Copyright>
    <Description>Compile-time Roslyn analyzers and code fixes for .NET HttpClient, IHttpClientFactory, AddHttpClient typed clients, named clients, Polly, and Microsoft.Extensions.Http.Resilience. Catch socket exhaustion, missing PooledConnectionLifetime, stale DNS, DI lifetime leaks, stacked AddStandardResilienceHandler pipelines, unsafe POST retries, ResponseHeadersRead disposal, CancellationToken gaps, and sync-over-async at build time—before production, not at runtime. Analyzer-only: no application runtime dependency.</Description>
    <PackageTags>httpclient;ihttpclientfactory;httpclientfactory;AddHttpClient;resilience;http-resilience;polly;AddStandardResilienceHandler;PooledConnectionLifetime;dotnet;csharp;roslyn;roslyn-analyzer;analyzer;analyser;analyzers;dotnet-analyzers;code-fix;compiler;aspnetcore;static-analysis;dependency-injection;delegatinghandler;socketshttphandler;socket-exhaustion;dns;typed-client;named-client;retry;cancellationtoken;cancellation-token;response-disposal;resilience-pipeline;microsoft-extensions-http-resilience</PackageTags>
    <PackageProjectUrl>https://github.com/georgepwall1991/HttpClient.Resilience.Analyzers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/georgepwall1991/HttpClient.Resilience.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Keep HCR041 fixes from overwriting existing retry predicates, with regression coverage and documentation.</PackageReleaseNotes>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HttpClient.Resilience.Analyzers\HttpClient.Resilience.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\PACKAGE_README.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\**\*" Pack="true" PackagePath="assets\" />
    <None Include="..\..\profiles\*.editorconfig" Pack="true" PackagePath="contentFiles/any/any/profiles" />
    <None Include="..\HttpClient.Resilience.Analyzers\bin\$(Configuration)\netstandard2.0\HttpClient.Resilience.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
